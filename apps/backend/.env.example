# Required — fallback payTo when a seller has none registered
VOUCH_PAY_TO=YOUR_ALGORAND_TESTNET_ADDRESS

# GoPlausible facilitator (Algorand x402)
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Public site (referral short links)
PUBLIC_SITE_URL=http://localhost:5173

# Local mock seller upstream
SELLER_SERVICE_URL=http://localhost:4001
PORT=4000

# Demo shortcuts (unsigned referrals / free mint). Keep false on shared hosts.
DEMO_MODE=false

# On-chain escrow (npm run deploy:escrow)
# ESCROW_APP_ID=
# VOUCH_OPERATOR_MNEMONIC=
# VOUCH_OPERATOR_ADDRESS=
# USDC_ASA_ID=10458941

# Required for POST /escrow/:id/withdraw (header: x-vouch-operator-key)
# VOUCH_OPERATOR_API_KEY=

# Shared HMAC secret for native fulfill (X-Vouch-Fulfill). Must match seller.
# Required — generate with: openssl rand -hex 32
VOUCH_FULFILL_SECRET=
